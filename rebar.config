{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {thoas, "1.1.0"},
    {cowboy, "2.12.0"}
]}.

{profiles, [
    {test, [{erl_opts, [debug_info]}]},
    {prod, [{erl_opts, [debug_info]}]}
]}.

{relx, [
    {release, {etherlang, "0.1.0"}, [etherlang, sasl]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{eunit_opts, [verbose]}.